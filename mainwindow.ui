    background-color: #413B6B;
    color: #FFFFFF;
    font-family: &quot;Inter&quot;;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 4px;
    border: none;
    border-right: 1px solid #372554;
}

QHeaderView::section:last {
    border-right: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 6px 2px 6px 0px;
}

QScrollBar::handle:vertical {
    background: #52468A;
    border-radius: 3px;
}</string>
       </property>
